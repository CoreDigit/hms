FROM dunglas/frankenphp:php8.2-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libicu-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy Laravel application first
COPY . .

# Install PHP dependencies without running Laravel scripts yet
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# Create required Laravel directories
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache

RUN chmod -R 775 storage bootstrap/cache

# Generate Laravel package discovery after artisan exists
RUN php artisan package:discover --ansi

# Create storage symlink
RUN php artisan storage:link || true

# Build frontend assets
RUN if [ -f package.json ]; then \
        apt-get update && apt-get install -y nodejs npm && \
        npm install && \
        npm run build && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Start FrankenPHP on Vercel's PORT
CMD ["sh", "-c", "frankenphp php-server --root /app/public --listen :${PORT:-80}"]