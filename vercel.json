{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": [
        "app/**",
        "bootstrap/**",
        "config/**",
        "database/**",
        "lang/**",
        "public/**",
        "resources/**",
        "routes/**",
        "storage/**",
        "vendor/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(assets|build|css|js|backend|frontend|uploads|storage)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
